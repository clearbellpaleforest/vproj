#!/bin/bash
# vproj-ai-chat — Terminal-based AI chat for vproj_ai
# Run by Vim :terminal (vproj#ai#AiTerminalChat). Pure bash + curl; no jq.
#
# Inputs (environment):
#   VPROJ_AI_KEYFILE  file holding the API key; read once, then deleted
#   VPROJ_AI_TMPFILE  file holding the system message as one JSON string
#                     literal (written by Vim); read once, deleted on exit
#   VPROJ_AI_API_URL  chat-completions endpoint
#   VPROJ_AI_MODEL    model name
#
# Loops: read prompt → curl SSE → stream response → repeat.
# The key and the request body go to curl through 0600 temp files
# (-H @file, --data-binary @file), never through argv.
set -euo pipefail
umask 077

REQUEST_FILE="${VPROJ_AI_TMPFILE:-}"
AUTH_HDR=""
BODY_FILE=""
CURL_ERRORS=""
CURL_EXIT_FILE=""

cleanup() {
  local f
  for f in "$AUTH_HDR" "$BODY_FILE" "$CURL_ERRORS" "$CURL_EXIT_FILE" "$REQUEST_FILE"; do
    if [ -n "$f" ]; then
      rm -f -- "$f"
    fi
  done
}
trap cleanup EXIT

# Read API key from temp file (never in /proc/pid/environ or cmdline).
# The file is deleted immediately after reading.
API_KEY=""
if [ -n "${VPROJ_AI_KEYFILE:-}" ] && [ -f "$VPROJ_AI_KEYFILE" ]; then
  API_KEY=$(<"$VPROJ_AI_KEYFILE")
  rm -f -- "$VPROJ_AI_KEYFILE"
fi
API_URL="${VPROJ_AI_API_URL:-https://api.deepseek.com/v1/chat/completions}"
MODEL="${VPROJ_AI_MODEL:-deepseek-chat}"

if ! command -v curl >/dev/null 2>&1; then
  echo "vproj-ai: curl is required but not found in PATH"
  exit 1
fi

if [ -z "$API_KEY" ]; then
  echo "vproj-ai: no API key (VPROJ_AI_KEYFILE missing or empty)."
  echo "Start the chat from Vim (A in the vproj pane) with g:vproj_ai_api_key,"
  echo "\$DEEPSEEK_API_KEY or \$OPENAI_API_KEY set."
  exit 1
fi

# ── Fault injection (VPROJ_AI_TEST_FAIL) ──
if [ -n "${VPROJ_AI_TEST_FAIL:-}" ]; then
  case "$VPROJ_AI_TEST_FAIL" in
    api_401)
      echo '{"error":{"message":"Authentication failed","type":"authentication_error"}}'
      exit 1
      ;;
    api_500)
      echo '{"error":{"message":"Internal server error","type":"server_error"}}'
      exit 1
      ;;
    api_timeout)
      sleep 999
      exit 1
      ;;
    disk_full)
      echo "[simulated: write failed]" >&2
      exit 1
      ;;
    empty_response)
      exit 1
      ;;
    malformed_sse)
      echo "this is not valid SSE data"
      exit 1
      ;;
    *)
      echo "vproj-ai: Unknown VPROJ_AI_TEST_FAIL value: $VPROJ_AI_TEST_FAIL" >&2
      exit 1
      ;;
  esac
fi

# ── JSON string escaper (pure bash, no forks) ──
# Sets JSON_OUT to the JSON string literal for $1, quotes included.
json_escape() {
  local s="$1" i hex ch rep
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\r'/\\r}
  s=${s//$'\t'/\\t}
  s=${s//$'\b'/\\b}
  s=${s//$'\f'/\\f}
  # Remaining control characters U+0001-U+001F (bash strings hold no NUL).
  for (( i = 1; i < 32; i++ )); do
    printf -v hex '%02x' "$i"
    # shellcheck disable=SC2059 # format is a single \xHH escape built above
    printf -v ch "\\x$hex"
    if [[ "$s" == *"$ch"* ]]; then
      printf -v rep '\\u%04x' "$i"
      s=${s//"$ch"/"$rep"}
    fi
  done
  JSON_OUT="\"$s\""
}

# ── UTF-8 encoder (pure bash) ──
# Sets UTF8_OUT to the UTF-8 bytes of code point $1. Code points that are
# not scalar values (NUL, lone surrogates, > U+10FFFF) become U+FFFD.
utf8_encode() {
  local cp=$1 fmt
  if (( cp == 0 || (cp >= 0xD800 && cp <= 0xDFFF) || cp > 0x10FFFF )); then
    cp=0xFFFD
  fi
  if (( cp < 0x80 )); then
    printf -v fmt '\\x%02x' "$cp"
  elif (( cp < 0x800 )); then
    printf -v fmt '\\x%02x\\x%02x' $(( 0xC0 | cp >> 6 )) $(( 0x80 | (cp & 0x3F) ))
  elif (( cp < 0x10000 )); then
    printf -v fmt '\\x%02x\\x%02x\\x%02x' $(( 0xE0 | cp >> 12 )) \
      $(( 0x80 | ((cp >> 6) & 0x3F) )) $(( 0x80 | (cp & 0x3F) ))
  else
    printf -v fmt '\\x%02x\\x%02x\\x%02x\\x%02x' $(( 0xF0 | cp >> 18 )) \
      $(( 0x80 | ((cp >> 12) & 0x3F) )) $(( 0x80 | ((cp >> 6) & 0x3F) )) $(( 0x80 | (cp & 0x3F) ))
  fi
  # shellcheck disable=SC2059 # fmt holds only \xHH escapes built above
  printf -v UTF8_OUT "$fmt"
}

# ── Extract content delta from one SSE JSON payload (pure bash) ──
# Sets DELTA to the decoded value of the first "content" string field,
# or to "" when there is none (e.g. "content":null).
extract_delta() {
  local data="$1" content hex lo cp
  DELTA=""
  if ! [[ "$data" =~ \"content\":[[:space:]]*\" ]]; then
    return 0
  fi
  content=${data#*"${BASH_REMATCH[0]}"}
  local i=0 len=${#content} c next
  while (( i < len )); do
    c=${content:i:1}
    if [ "$c" = '"' ]; then
      break
    fi
    if [ "$c" != "\\" ] || (( i + 1 >= len )); then
      DELTA+=$c
      i=$(( i + 1 ))
      continue
    fi
    next=${content:i+1:1}
    case "$next" in
      '"') DELTA+='"'; i=$(( i + 2 )) ;;
      "\\") DELTA+="\\"; i=$(( i + 2 )) ;;
      '/') DELTA+='/'; i=$(( i + 2 )) ;;
      'n') DELTA+=$'\n'; i=$(( i + 2 )) ;;
      't') DELTA+=$'\t'; i=$(( i + 2 )) ;;
      'r') DELTA+=$'\r'; i=$(( i + 2 )) ;;
      'b') DELTA+=$'\b'; i=$(( i + 2 )) ;;
      'f') DELTA+=$'\f'; i=$(( i + 2 )) ;;
      'u')
        hex=${content:i+2:4}
        if ! [[ "$hex" =~ ^[0-9a-fA-F]{4}$ ]]; then
          DELTA+="$c$next"
          i=$(( i + 2 ))
          continue
        fi
        cp=$(( 16#$hex ))
        i=$(( i + 6 ))
        # UTF-16 surrogate pair: \uD8xx\uDCxx
        if (( cp >= 0xD800 && cp <= 0xDBFF )) && [ "${content:i:2}" = '\u' ]; then
          lo=${content:i+2:4}
          if [[ "$lo" =~ ^[dD][c-fC-F][0-9a-fA-F]{2}$ ]]; then
            cp=$(( 0x10000 + ((cp - 0xD800) << 10) + (16#$lo - 0xDC00) ))
            i=$(( i + 6 ))
          fi
        fi
        utf8_encode "$cp"
        DELTA+=$UTF8_OUT
        ;;
      *) DELTA+="$c$next"; i=$(( i + 2 )) ;;
    esac
  done
}

# ── System message (JSON string literal written by Vim) ──
SYSTEM_JSON=""
if [ -n "$REQUEST_FILE" ] && [ -s "$REQUEST_FILE" ]; then
  SYSTEM_JSON=$(<"$REQUEST_FILE")
  # Must be exactly one JSON string literal on one line.
  if [[ "$SYSTEM_JSON" != \"*\" || "$SYSTEM_JSON" == *$'\n'* ]]; then
    SYSTEM_JSON=""
  fi
fi
if [ -z "$SYSTEM_JSON" ]; then
  json_escape "You are a coding assistant embedded in Vim (vproj_ai). Be concise. Wrap code in \`\`\` fences with a language tag."
  SYSTEM_JSON=$JSON_OUT
fi

json_escape "$MODEL"
MODEL_JSON=$JSON_OUT

# ── Temp files: created once (0600 via umask), removed by the EXIT trap ──
AUTH_HDR=$(mktemp)
BODY_FILE=$(mktemp)
CURL_ERRORS=$(mktemp)
CURL_EXIT_FILE=$(mktemp)
printf 'Authorization: Bearer %s' "$API_KEY" > "$AUTH_HDR"

# ── Conversation history (JSON message array, closing ] added per request) ──
MESSAGES="[{\"role\":\"system\",\"content\":$SYSTEM_JSON}"

echo "+- vproj_ai chat ------------------------------+"
echo "| model: $MODEL"
echo "| endpoint: $API_URL"
if [ "${VPROJ_AI_TEST:-0}" = "1" ]; then
  echo "| [test mode -- no API calls]                    |"
fi
echo "| Type /exit or Ctrl-D to quit                 |"
echo "+----------------------------------------------+"
echo ""

# ── Main chat loop ──
while true; do
  printf "> "
  IFS= read -r PROMPT || { echo ""; break; }
  if [ -z "$PROMPT" ]; then
    continue
  fi
  if [ "$PROMPT" = "/exit" ] || [ "$PROMPT" = "/q" ]; then
    break
  fi

  # Add user message to history
  json_escape "$PROMPT"
  MESSAGES+=",{\"role\":\"user\",\"content\":$JSON_OUT}"

  echo ""

  # ── Stream response from API ──
  FULL_RESPONSE=""
  RAW_RESPONSE=""
  : > "$CURL_ERRORS"
  : > "$CURL_EXIT_FILE"
  if [ "${VPROJ_AI_TEST:-0}" = "1" ]; then
    # ── Test mode ──
    echo "[test echo] $PROMPT"
    FULL_RESPONSE="[test echo] $PROMPT"
  else
    printf '{"model":%s,"messages":%s],"stream":true}' "$MODEL_JSON" "$MESSAGES" > "$BODY_FILE"
    while IFS= read -r line; do
      line=${line%$'\r'}
      RAW_RESPONSE+="$line"$'\n'
      if [[ "$line" =~ ^data:[[:space:]]*(.*) ]]; then
        data="${BASH_REMATCH[1]}"
        if [[ "$data" == "[DONE]"* ]]; then
          break
        fi
        extract_delta "$data"
        if [ -n "$DELTA" ]; then
          printf "%s" "$DELTA"
          FULL_RESPONSE+="$DELTA"
        fi
      fi
    done < <(
      rc=0
      curl -sS --no-buffer \
        --connect-timeout 10 -m 120 \
        -H "Content-Type: application/json" \
        -H "@$AUTH_HDR" \
        --data-binary "@$BODY_FILE" \
        "$API_URL" 2>"$CURL_ERRORS" || rc=$?
      echo "$rc" > "$CURL_EXIT_FILE"
    )
    # Let curl finish so its exit status is in CURL_EXIT_FILE.
    wait "$!" 2>/dev/null || true
  fi

  echo ""
  echo ""

  # Read curl exit code
  CURL_EXIT=$(<"$CURL_EXIT_FILE")
  CURL_EXIT=${CURL_EXIT:-0}

  # Show curl errors if any
  if [ -s "$CURL_ERRORS" ]; then
    printf '\033[31m[curl error (exit %s): %s]\033[0m\n' "$CURL_EXIT" "$(tr '\n' ' ' < "$CURL_ERRORS")"
  fi

  # Add assistant response to conversation history
  if [ -n "$FULL_RESPONSE" ]; then
    json_escape "$FULL_RESPONSE"
    MESSAGES+=",{\"role\":\"assistant\",\"content\":$JSON_OUT}"
  else
    # Show raw response to help diagnose the issue
    if [ -n "$RAW_RESPONSE" ]; then
      printf '\033[31m[API returned non-SSE response (curl exit %s, endpoint %s):]\033[0m\n' "$CURL_EXIT" "$API_URL"
      printf '%s' "$RAW_RESPONSE" | head -20 || true
    else
      printf '\033[31m[no response -- curl exit %s, endpoint: %s, model: %s]\033[0m\n' "$CURL_EXIT" "$API_URL" "$MODEL"
    fi
  fi
done

echo "bye."
